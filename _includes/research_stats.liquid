{% assign s = site.data.pubstats %}
<ul class="stat-strip" aria-label="Papers per research area">
  <li><span class="stat-value">{{ s.published | plus: s.preprints }}</span><span class="stat-label">papers <small>{{ s.published }} published · {{ s.preprints }} preprints</small></span></li>
  <li class="stat-sep"></li>
  <li><a href="#large-language-models"><span class="stat-value">{{ s.sections.llm }}</span><span class="stat-label">Large Language Models</span></a></li>
  <li><a href="#multimodal-models"><span class="stat-value">{{ s.sections.mllm }}</span><span class="stat-label">Multimodal Models</span></a></li>
  <li><a href="#agents-world-models"><span class="stat-value">{{ s.sections.agents }}</span><span class="stat-label">Agents &amp; World Models</span></a></li>
  <li><a href="#learning-paradigms"><span class="stat-value">{{ s.sections.paradigms }}</span><span class="stat-label">Learning Paradigms</span></a></li>
  <li><a href="#foundations-earlier-work"><span class="stat-value">{{ s.sections.foundations }}</span><span class="stat-label">Foundations &amp; Earlier Work</span></a></li>
</ul>
