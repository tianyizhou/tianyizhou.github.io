{% if page.facts %}
  <ul class="fact-strip">
    {% for f in page.facts %}
      <li>
        {% if f.url %}<a href="{{ f.url }}">{% endif %}
        <span class="fact-value">{{ f.value }}</span>
        <span class="fact-label">{{ f.label }}</span>
        {% if f.url %}</a>{% endif %}
      </li>
    {% endfor %}
  </ul>
{% endif %}
