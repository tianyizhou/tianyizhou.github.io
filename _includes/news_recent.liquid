{% comment %}
  News from the last N months (default 12), newest first. Falls back to the latest 6 items
  if nothing is that recent, so the section is never empty.
{% endcomment %}
{% assign months = include.months | default: 12 %}
{% assign window = months | times: 2629800 %}
{% assign now_ts = site.time | date: '%s' | plus: 0 %}
{% assign cutoff = now_ts | minus: window %}
{% assign news = site.news | sort: 'date' | reverse %}
{% assign recent = '' | split: '' %}
{% for item in news %}
  {% assign ts = item.date | date: '%s' | plus: 0 %}
  {% if ts >= cutoff %}
    {% assign recent = recent | push: item %}
  {% endif %}
{% endfor %}
{% if recent.size == 0 %}
  {% assign recent = news | slice: 0, 6 %}
{% endif %}
<div class="news">
  <div class="table-responsive news-scroll">
    <table class="table table-sm table-borderless">
      {% for item in recent %}
        <tr>
          <th scope="row" class="news-date">{{ item.date | date: '%b %Y' }}</th>
          <td>
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>
  </div>
</div>
